# Production environment template — Phase 11.
#
# Copy to `.env` on the server and fill in every SECRET_* value. Never commit the
# filled file.
#
# The values marked REQUIRED are ones the application will refuse to start
# without, or that silently weaken security when left at their development
# default.

APP_NAME=WorkSphere
APP_ENV=production

# REQUIRED, and must be `false`.
# `true` renders stack traces, environment variables and SQL on any error page.
# Every unhandled exception in production becomes a data-disclosure page.
APP_DEBUG=false

APP_URL=https://worksphere.example.com

# REQUIRED. Generate per environment:
#   php artisan key:generate
# Rotating this invalidates every existing cookie, session and encrypted column.
APP_KEY=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# `str` refuses to boot in production, which is the point: a production deploy
# that forgot APP_DEBUG is a failed deploy, not a public stack trace.
APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# REQUIRED, production value `info`.
# `debug` records every query including bound values, which means tokens,
# passwords and personal data land in the log file.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=info

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=worksphere
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=

# REQUIRED in production. Without it the session cookie is sent over plain HTTP
# and can be read from the wire.
SESSION_SECURE_COOKIE=true
# Off for the API, which is stateless and token-authenticated.
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# REQUIRED if Redis is used.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="${APP_NAME}"

# Phase 11.
#
# Which proxies to trust for X-Forwarded-*. One hop matches a single nginx.
# A comma-separated list matches a known load balancer.
# `*` is REFUSED by the application: it lets any client forge X-Forwarded-For,
# and therefore its own rate-limit identity.
TRUSTED_PROXIES=127.0.0.1,::1

# Phase 11. Sanctum token lifetime in minutes. `null` means a leaked token is a
# permanent credential; this application refuses to run with it unset.
SANCTUM_EXPIRATION=1440

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
